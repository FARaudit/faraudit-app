# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# CEO tools — local only, never deploy to Vercel
ceo/
*.pdf

# OAuth bootstrap — script is tracked, but block any accidental token/secret files
scripts/oauth/*
!scripts/oauth/
!scripts/oauth/get-token.js

# Sync log artifacts (launchd output — never source)
scripts/sync-digest*.log
# The audit-flow launchd agent (com.faraudit.auditflow, StartInterval 300) writes these
# two logs every five minutes. PR #708 untracked them but this rule was left out of that
# commit, so they came straight back as '??' noise — the same dirty tree wearing a
# different symbol. Its sibling agent's log is ignored on the line above.
scripts/audit-flow-refresh.*.log

# Local test artifacts
outputs/
state-snapshot.txt
src/app/globals.css.bak-phase1
*.bak-*
src/app/sign-in/*.bak*
src/app/pricing/*.bak*
public/*.bak*
src/app/globals.css.bak*

# Playwright
e2e/.auth/
playwright-report/
test-results/
# e2e diagnostic probes (session-local, not part of the test suite)
e2e/tests/_diag-*.spec.ts
# local PDF verification artifacts (FA-130 era exports)
test/pdfs/
supabase/.temp/

.claude/worktrees/

# Paid-run diagnostic records (card 197) — contain real solicitation source; never commit
scripts/audit-ai/run-records/*
!scripts/audit-ai/run-records/.gitkeep

# GROUNDFIXTURE — local cache of banked RunRecords pulled from the Supabase run-records
# bucket. Regenerated on demand by _replay-harness.ts (--refresh); never a source of truth.
scripts/audit-ai/.run-record-cache/
